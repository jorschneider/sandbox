default_platform(:ios)

BUNDLE_ID = ENV["CRUX_BUNDLE_ID"] || "com.crux.coach"

platform :ios do
  before_all do
    # Authenticate with an App Store Connect API key (no Apple-ID 2FA needed).
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],      # raw contents of the .p8 file
      is_key_content_base64: false
    )
  end

  desc "Build the iOS app and upload it to TestFlight"
  lane :beta do
    setup_ci   # temporary CI keychain

    # Make sure the app + bundle id exist in App Store Connect (no-op if they do).
    begin
      produce(app_identifier: BUNDLE_ID, app_name: ENV["CRUX_APP_NAME"] || "CRUX")
    rescue => e
      UI.important("produce skipped (app likely already exists): #{e.message}")
    end

    # Distribution signing certs + provisioning profile, stored in a private repo.
    match(type: "appstore", app_identifier: BUNDLE_ID, readonly: false)

    increment_build_number(
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.to_i.to_s,
      xcodeproj: "ios/App/App.xcodeproj"
    )

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Build and submit to the App Store for review"
  lane :release do
    beta   # reuse the build+upload, then submit the latest build
    deliver(
      submit_for_review: true,
      automatic_release: true,
      force: true,                     # skip interactive HTML preview
      skip_screenshots: true,          # manage screenshots in App Store Connect
      precheck_include_in_app_purchases: false
    )
  end
end
